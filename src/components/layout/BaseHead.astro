---
import {
  ORGANIZATION_ID,
  ORGANIZATION_LOGO,
  OG_IMAGE,
  PAGE_META,
  SITE_URL,
  WEBSITE_ID,
} from "../../data/seo";
import { SITE } from "../../data/site";
import { SERVICES } from "../../data/content";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = PAGE_META.home.title,
  description = PAGE_META.home.description,
  noindex = false,
} = Astro.props;

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonicalUrl = new URL(pathname, SITE_URL).href;
const socialImage = OG_IMAGE.url;
const robotsContent = noindex
  ? "noindex, follow"
  : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": ORGANIZATION_ID,
      name: SITE.nombre,
      description: SITE.description,
      url: `${SITE_URL}/`,
      logo: ORGANIZATION_LOGO,
      email: SITE.email,
      telephone: SITE.telefono,
      areaServed: SITE.areasServed.map(({ type, name }) => ({
        "@type": type,
        name,
      })),
      sameAs: Object.values(SITE.socialLinks),
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "sales",
        email: SITE.email,
        telephone: SITE.telefono,
        availableLanguage: ["Spanish", "English"],
      },
      founder: { "@id": `${SITE_URL}/#founder` },
      knowsAbout: SERVICES.map(({ title }) => title),
    },
    {
      "@type": "Person",
      "@id": `${SITE_URL}/#founder`,
      name: SITE.founder,
      worksFor: { "@id": ORGANIZATION_ID },
      sameAs: Object.values(SITE.socialLinks),
    },
    {
      "@type": "WebSite",
      "@id": WEBSITE_ID,
      url: `${SITE_URL}/`,
      name: SITE.nombre,
      description: SITE.description,
      publisher: { "@id": ORGANIZATION_ID },
      inLanguage: "es-MX",
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description,
      isPartOf: { "@id": WEBSITE_ID },
      about: { "@id": ORGANIZATION_ID },
      inLanguage: "es-MX",
    },
  ],
};
const structuredDataJson = JSON.stringify(structuredData).replace(
  /</g,
  "\\u003c",
);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.founder} />
<meta name="robots" content={robotsContent} />
<link rel="canonical" href={canonicalUrl} />
<meta name="theme-color" content="#9F303A" />
<meta property="og:locale" content="es_MX" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.nombre} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:width" content={String(OG_IMAGE.width)} />
<meta property="og:image:height" content={String(OG_IMAGE.height)} />
<meta property="og:image:type" content={OG_IMAGE.type} />
<meta property="og:image:alt" content={OG_IMAGE.alt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={OG_IMAGE.alt} />
<script type="application/ld+json" set:html={structuredDataJson} />