---
const socialLinks = [
  { name: 'LinkedIn', url: 'https://www.linkedin.com/in/erickvargascorona/', id: '01' },
  { name: 'GitHub', url: 'https://github.com/evargasdev', id: '02' },
];

const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-[#bdb8b0] text-black">
  {/* Enlaces y Créditos */}
  <div class="grid grid-cols-1 border-b-4 border-black sm:grid-cols-2 lg:grid-cols-3 font-mono text-xs font-black uppercase">
    {socialLinks.map((link) => (
      <a
        href={link.url}
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center justify-between border-b-4 border-black p-6 transition-colors hover:bg-[#9f303a] hover:text-white sm:border-r-4 lg:border-b-0 md:p-8"
      >
        <div class="flex items-center gap-3">
          <span class="text-[10px] opacity-60">[{link.id}]</span>
          <span>{link.name}</span>
        </div>
        <span class="text-base transition-transform group-hover:translate-x-1 group-hover:-translate-y-1">↗</span>
      </a>
    ))}

    {/* Columna de Autoría */}
    <div class="flex flex-col justify-between p-6 bg-[#e8e6e1] md:p-8">
      <div class="text-[10px] tracking-widest opacity-60">// IDENTIDAD CENTRAL</div>
      <div class="mt-2 leading-tight">
        <strong class="block text-sm font-black tracking-tight">EL YUNQUE</strong>
        <span class="text-[11px]">ERICK VARGAS</span>
      </div>
    </div>
  </div>

  {/* Franja Inferior Técnica */}
  <div class="flex flex-col items-start justify-between gap-2 px-6 py-4 font-mono text-[10px] font-bold uppercase tracking-widest sm:flex-row sm:items-center md:px-8">
    <div>
      © {currentYear} EL YUNQUE — ERICK VARGAS — TODOS LOS DERECHOS RESERVADOS
    </div>
    <div class="flex items-center gap-4 text-black/70">
      <span>ASTRO + VERCEL</span>
    </div>
  </div>
</footer>