---
import { IconBrandGithub, IconBrandGithubFilled, IconBrandLinkedin, IconBrandLinkedinFilled } from "@tabler/icons-astro";

const currentYear = new Date().getFullYear();
---

<footer class="w-full bg-[#bdb8b0] text-black">
  {/* Enlaces y Créditos */}
  <div
    class="grid grid-cols-2 border-b-4 border-black font-mono text-xs font-black uppercase"
  >
    <a
      href="https://www.linkedin.com/in/erickvargascorona/"
      target="_blank"
      rel="noopener noreferrer"
      class="group flex items-center justify-between border-r-4 border-black p-4 transition-colors hover:bg-primary hover:text-white sm:p-6 md:p-8"
    >
      <div class="flex items-center gap-3">
        <IconBrandLinkedinFilled/>
        <span>LinkedIn</span>
      </div>
      <span
        class="text-base transition-transform group-hover:translate-x-1 group-hover:-translate-y-1"
        >↗</span
      >
    </a>
    <a
      href="https://github.com/evargasdev"
      target="_blank"
      rel="noopener noreferrer"
      class="group flex items-center justify-between p-4 transition-colors hover:bg-primary hover:text-white sm:p-6 md:p-8"
    >
      <div class="flex items-center gap-3">
        <IconBrandGithubFilled/>
        <span>GitHub</span>
      </div>
      <span
        class="text-base transition-transform group-hover:translate-x-1 group-hover:-translate-y-1"
        >↗</span
      >
    </a>
  </div>

  {/* Franja Inferior Técnica */}
  <div
    class="flex flex-col items-start justify-between gap-4 px-6 py-4 font-mono text-[10px] font-bold uppercase tracking-normal sm:flex-row sm:items-center sm:text-xs sm:tracking-widest md:px-8"
  >
    <div class="leading-relaxed">
      © {currentYear} EL YUNQUE <span class="text-primary">X</span> ERICK VARGAS <span class="text-primary">//</span> TODOS LOS DERECHOS RESERVADOS
    </div>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-black/70">
      <a
        href="/aviso-de-privacidad"
        class="hover:text-primary transition-colors">AVISO DE PRIVACIDAD</a
      >
      <a
        href="/terminos-y-condiciones"
        class="hover:text-primary transition-colors">TÉRMINOS Y CONDICIONES</a
      >
    </div>
  </div>
</footer>
