---
import { SITE } from "../../data/site";
import { PAGE_META } from "../../data/seo";

const [brand, name] = SITE.nombre.split(" X ");
---

<header
  class="fixed inset-x-0 top-0 z-50 backdrop-blur-2xl bg-surface/70 border-b-4 border-black"
>
  <div
    class="mx-auto flex w-full max-w-full items-center justify-between px-5 py-4 md:px-8"
  >
    <a href={PAGE_META.home.path} class="text-xl font-bold uppercase md:text-xl"
      >{brand} <span class="hidden sm:inline"
        ><span class="text-primary">//</span> {name}</span
      ></a
    >
    <nav class="gap-2 text-sm font-bold uppercase sm:flex">
      <a
        href="#contact"
        class="border-2 border-black bg-black px-3 py-2 text-white transition-colors hover:bg-primary"
        >A trabajar</a
      >
    </nav>
  </div>
</header>
