---
const accent = "#9f303a";

const stack = [
  ["TypeScript", "typescript"],
  ["Javascript", "javascript"],
  ["HTML", "html5"],
  ["CSS", "css3"],
  ["Node.js", "nodejs"],
  ["Astro", "astro"],
  ["Next.js", "nextjs"],
  ["Nest.js", "nestjs"],
  ["React", "react"],
  ["Vue", "vuejs"],
  ["PostgreSQL", "postgresql"],
  ["Docker", "docker"],
  ["Git", "git"],
  ["GitHub", "github"],
  ["Vercel", "vercel"],
];
---

<section id="stack" class="w-full border-b-4 border-black">
  <div class="grid md:grid-cols-2">
    <div class="border-b-4 border-black md:border-b-0 md:">
      <div class="border-b-4 border-black p-5 md:p-8">
        <span class="font-mono text-xs font-bold text-primary"
          >[ 02 // LA MÁQUINA ]</span
        >
      </div>
      <div class="grid grid-cols-5">
        {
          stack.slice(0, 15).map(([name, icon], i) => (
            <div class="flex aspect-square flex-col items-center justify-center gap-2 border-2 border-black p-2 text-center transition-colors bg-surface hover:bg-primary hover:text-white">
              <img
                src={`https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/${icon}/${icon}-original.svg`}
                alt={`${name} logo`}
                class="h-10 w-10 object-contain grayscale-80 sm:h-14 sm:w-14 md:h-24 md:w-24"
              />
              <span class="break-all font-mono text-[9px] font-bold uppercase leading-tight sm:text-[10px] md:text-[14px]">
                {name}
              </span>
            </div>
          ))
        }
      </div>
    </div>
    <div
      class="relative flex min-h-60 items-center justify-center overflow-hidden bg-black p-4 text-surface md:min-h-125 md:p-8"
    >
      <div class="relative z-10 text-center">
        <span class="font-mono text-xs font-bold text-primary"
          >[ STACK // ARSENAL ]</span
        >
        <h2
          class="mt-4 text-[18vw] font-black uppercase leading-[0.8] tracking-[-0.08em] md:text-[13vw] md:leading-[0.75] md:-tracking-widest"
        >
          STACK
        </h2>
      </div>
    </div>
  </div>
</section>
