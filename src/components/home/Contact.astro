---
import { Icon24Hours, IconBrandWhatsapp, IconMail } from "@tabler/icons-astro";
---

<section
  id="contact"
  class="w-full border-b-4 border-black bg-surface text-black"
>
  <div class="grid grid-cols-1 md:grid-cols-[280px_1fr]">
    {/* Columna Izquierda: Label + Metadata */}
    <div
      class="flex flex-col justify-between border-b-4 border-black p-6 md:border-b-0 md:border-r-4 md:p-8"
    >
      <div>
        <span class="font-mono text-xs font-black tracking-widest text-primary">
          [ 04 // CONTACTO ]
        </span>
        <h3
          class="mt-4 font-mono text-xs font-bold uppercase tracking-wider text-black/70"
        >
          // INICIAR TRANSMISIÓN
        </h3>
      </div>

      <div
        class="hidden mt-8 font-mono text-[11px] font-bold uppercase leading-relaxed md:mt-0 md:inline"
      >
        <p class="text-black/60">Estado:</p>
        <p class="mb-3 text-emerald-700">● DISPONIBLE PARA NUEVOS PROYECTOS</p>
        <p class="text-black/60">Tiempo de respuesta:</p>
        <p>&lt; 24 HORAS</p>
      </div>
    </div>

    {/* Columna Derecha: Headline + CTA */}
    <div class="flex flex-col justify-between p-6 md:p-12">
      <div>
        <h2
          class="font-black uppercase leading-[0.9] tracking-[-0.06em] text-4xl sm:text-5xl md:text-7xl md:leading-[0.85] md:tracking-[-0.07em] lg:text-8xl"
        >
          Construyamos<br />
          <span class="text-primary">sistemas</span><br />
          inquebrantables
        </h2>
        <p
          class="mt-6 max-w-lg font-mono text-xs font-bold uppercase leading-relaxed text-black/80 md:text-sm"
        >
          Diseñamos infraestructura tolerante a fallas y plataformas digitales
          hechas para operar bajo presión.
        </p>
      </div>

      <div class="flex flex-col gap-2 pt-6 sm:flex-row">
        <a
          href="mailto:erickdanielvargascorona@gmail.com"
          class="group inline-flex w-full max-w-full flex-wrap items-center justify-between gap-2 border-4 border-black bg-black px-3 py-4 font-mono text-xs font-black uppercase tracking-wide text-surface transition-all hover:bg-primary hover:text-white sm:w-auto sm:px-6 sm:py-5 sm:text-sm sm:tracking-wider sm:gap-4"
        >
          <IconMail />
          <span class="min-w-0 break-all">Envíanos un correo</span>
          <span
            class="text-xl transition-transform group-hover:translate-x-1 group-hover:-translate-y-1"
            >↗</span
          >
        </a>
        <a
          href="https://wa.me/529843209601?text=Hola%2C%20quiero%20conversar%20sobre%20un%20proyecto."
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex w-full max-w-full flex-wrap items-center justify-between gap-2 border-4 border-black bg-black px-3 py-4 font-mono text-xs font-black uppercase tracking-wide text-surface transition-all hover:bg-[#25D366] hover:text-black sm:w-auto sm:px-6 sm:py-5 sm:text-sm sm:tracking-wider sm:gap-4"
        >
          <IconBrandWhatsapp />
          <span class="min-w-0">Hablemos por WhatsApp</span>
          <span
            class="text-xl transition-transform group-hover:translate-x-1 group-hover:-translate-y-1"
            >↗</span
          >
        </a>
      </div>
    </div>
  </div>
</section>
