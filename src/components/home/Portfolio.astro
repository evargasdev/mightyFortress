---
import CardCarousel from "../layout/CardCarousel";


const accent = '#9f303a'
---
    <section id="work" class="w-full border-b-4 border-black text-black">
      <div class="flex items-end justify-between border-b-4 border-black p-5 md:p-8">
        <div>
          <span class="font-mono text-xs font-black tracking-widest" style={{ color: accent }}>
            [ 03 // PROYECTOS SELECCIONADOS ]
          </span>
          <h2 class="mt-2 text-4xl font-black uppercase leading-[0.9] tracking-[-0.06em] md:text-7xl">
            PRUEBA DE LETALIDAD.
          </h2>
        </div>
      </div>

      <CardCarousel client:idle/>
    </section>
