---
import { SERVICES } from "../../data/content";
---

<section id="systems" class="w-full border-black md:border-b-4">
  <div class="border-b-4 border-black bg-[#c9c5bd] p-5 md:p-8">
    <h2 class="text-xl font-black uppercase tracking md:text-5xl 2xl:text-7xl">
      Problemas duros <span class="text-primary">//</span> Soluciones más sólidas
    </h2>
  </div>
  <div class="grid sm:grid-cols-1 lg:grid-cols-4">
    {
      SERVICES.map((service) => (
        <article class="group flex flex-col md:min-h-62.5 justify-between bg-surface border-b-4 border-black p-5 md:p-8 lg:border-b-0 lg:border-x-2 transition-colors hover:bg-primary hover:text-white">
          <div>
            <div class="mb-6 md:mb-12 flex items-start justify-between">
              <span class="font-mono text-sm font-bold">{service.number}/</span>
              <span class="font-mono text-[10px] font-bold">EL YUNQUE</span>
            </div>
            <h3 class=" text-2xl font-black uppercase leading-[0.9] tracking-tighter md:text-3xl">
              {service.title}
            </h3>
          </div>
          <p class="text-sm mt-2 max-w-75 text-md font-medium md:text-base">
            {service.copy}
          </p>
        </article>
      ))
    }
  </div>
</section>
